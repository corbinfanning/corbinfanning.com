---
interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Corbin Fanning',
  description = 'Personal site of Corbin Fanning — writing, projects, and notes from learning agentic engineering.',
} = Astro.props;

const pathname = Astro.url.pathname.replace(/\/+$/, '') || '/';
const isActive = (href: string) => {
  if (href === '/') return pathname === '/';
  return pathname === href || pathname.startsWith(`${href}/`);
};
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
    <link rel="stylesheet" href="/styles/global.css" />
  </head>
  <body>
    <div class="page">
      <header class="site-header">
        <a class="logo" href="/">Corbin Fanning</a>
        <nav class="nav" aria-label="Primary">
          <a href="/" aria-current={isActive('/') ? 'page' : undefined}>Home</a>
          <a href="/about" aria-current={isActive('/about') ? 'page' : undefined}>About</a>
          <a href="/writing" aria-current={isActive('/writing') ? 'page' : undefined}>Writing</a>
          <a href="/projects" aria-current={isActive('/projects') ? 'page' : undefined}>Projects</a>
        </nav>
      </header>
      <main>
        <slot />
      </main>
      <footer class="site-footer">
        <span>© {new Date().getFullYear()} Corbin Fanning</span>
        <span class="footer-meta">Built in the open with Claude Code</span>
      </footer>
    </div>
  </body>
</html>
