---
import { getCollection, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const posts = await getCollection('writing', ({ data }) => !data.draft);
  return posts.map((post) => ({ params: { slug: post.slug }, props: { post } }));
}

type Props = { post: CollectionEntry<'writing'> };
const { post } = Astro.props;
const { Content } = await post.render();
---

<BaseLayout
  title={`${post.data.title} | Corbin Fanning`}
  description={post.data.description}
>
  <article class="prose">
    <header>
      <p class="meta">
        <time datetime={post.data.pubDate.toISOString()}>
          {post.data.pubDate.toLocaleDateString('en-US', {
            year: 'numeric', month: 'long', day: 'numeric',
          })}
        </time>
        {post.data.updatedDate && (
          <>
            {' · updated '}
            <time datetime={post.data.updatedDate.toISOString()}>
              {post.data.updatedDate.toLocaleDateString('en-US', {
                year: 'numeric', month: 'long', day: 'numeric',
              })}
            </time>
          </>
        )}
      </p>
      <h1>{post.data.title}</h1>
      {post.data.description && <p class="lede">{post.data.description}</p>}
    </header>
    <Content />
    <p class="meta back-link">
      <a href="/writing">← All writing</a>
    </p>
  </article>
</BaseLayout>
