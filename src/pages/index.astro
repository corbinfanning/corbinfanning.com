---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

const writing = (await getCollection('writing', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime())
  .slice(0, 3);

const projects = (await getCollection('projects', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime())
  .slice(0, 3);
---

<BaseLayout>
  <section class="hero">
    <p class="eyebrow">Hi, I'm Corbin.</p>
    <h1>
      {/* TODO: replace with a real one-line headline. */}
      Building things in the open while learning agentic engineering.
    </h1>
    <p class="lede">
      {/* TODO: write a real intro paragraph. */}
      This is my corner of the internet. I'm using it to share what I'm
      working on, write as I figure things out, and eventually post some
      photos. The whole site is iterated on from the Claude Code mobile app.
    </p>
    <div class="hero-actions">
      <a class="button" href="/writing">Read the writing</a>
      <a class="button secondary" href="/projects">See projects</a>
    </div>
  </section>

  {writing.length > 0 && (
    <section class="section">
      <div class="section-head">
        <h2>Recent writing</h2>
        <a class="text-link" href="/writing">All posts →</a>
      </div>
      <ul class="entry-list">
        {writing.map((post) => (
          <li>
            <a href={`/writing/${post.slug}`}>
              <h3>{post.data.title}</h3>
              <p class="meta">
                <time datetime={post.data.pubDate.toISOString()}>
                  {post.data.pubDate.toLocaleDateString('en-US', {
                    year: 'numeric', month: 'short', day: 'numeric',
                  })}
                </time>
              </p>
              {post.data.description && <p>{post.data.description}</p>}
            </a>
          </li>
        ))}
      </ul>
    </section>
  )}

  {projects.length > 0 && (
    <section class="section">
      <div class="section-head">
        <h2>Recent projects</h2>
        <a class="text-link" href="/projects">All projects →</a>
      </div>
      <div class="grid">
        {projects.map((project) => (
          <article class="card">
            <h3>
              <a href={`/projects/${project.slug}`}>{project.data.title}</a>
            </h3>
            <p>{project.data.description}</p>
          </article>
        ))}
      </div>
    </section>
  )}
</BaseLayout>
