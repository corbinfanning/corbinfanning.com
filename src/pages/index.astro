---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Corbin Fanning | Resume">
  <section class="hero">
    <div>
      <p class="eyebrow">Hi, I'm Corbin.</p>
      <h1>Product-focused engineer building thoughtful digital experiences.</h1>
      <p class="lede">
        I design and ship software that balances clarity, performance, and
        reliability. I enjoy partnering with teams to turn ideas into shipped
        products.
      </p>
      <div class="hero-actions">
        <a class="button" href="mailto:hello@corbinfanning.com">Email me</a>
        <a class="button secondary" href="/resume.pdf">Download résumé</a>
      </div>
    </div>
    <div class="card">
      <h2 id="about">About</h2>
      <p>
        I&apos;m a full-stack engineer with a background in product strategy and a
        decade of experience leading teams, shipping web platforms, and helping
        companies find their technical footing.
      </p>
      <ul>
        <li>Location: Seattle, WA (open to remote)</li>
        <li>Focus: Product engineering, platform, and developer experience</li>
        <li>Interests: Design systems, AI tooling, and thoughtful UX</li>
      </ul>
    </div>
  </section>

  <section class="section" id="experience">
    <h2>Experience</h2>
    <div class="timeline">
      <article>
        <h3>Staff Engineer · Example Company</h3>
        <p class="meta">2021 — Present</p>
        <p>
          Led a cross-functional team shipping a modernized customer portal and
          reduced onboarding time by 40%.
        </p>
      </article>
      <article>
        <h3>Senior Engineer · Example Studio</h3>
        <p class="meta">2017 — 2021</p>
        <p>
          Built a design system and internal tooling that accelerated feature
          delivery across five product lines.
        </p>
      </article>
      <article>
        <h3>Product Engineer · Startup</h3>
        <p class="meta">2012 — 2017</p>
        <p>
          Shipped the first version of a B2B platform, partnering with founders
          and customers to define the roadmap.
        </p>
      </article>
    </div>
  </section>

  <section class="section" id="projects">
    <h2>Selected projects</h2>
    <div class="grid">
      <article class="card">
        <h3>Portfolio OS</h3>
        <p>
          A modular portfolio kit built with Astro and MDX for fast updates and
          flexible storytelling.
        </p>
        <a href="https://github.com" class="text-link">View on GitHub</a>
      </article>
      <article class="card">
        <h3>Writing Studio</h3>
        <p>
          A minimal writing environment that supports daily prompts and a
          publish-to-web workflow.
        </p>
        <a href="https://example.com" class="text-link">Explore the demo</a>
      </article>
      <article class="card">
        <h3>Launchpad</h3>
        <p>
          An idea tracking tool for product teams that keeps experiments and
          learnings together.
        </p>
        <a href="https://example.com" class="text-link">See case study</a>
      </article>
    </div>
  </section>

  <section class="section" id="contact">
    <h2>Let&apos;s connect</h2>
    <p>
      I&apos;m always interested in new collaborations, writing projects, and
      community work. Reach out any time.
    </p>
    <div class="contact">
      <a href="mailto:hello@corbinfanning.com" class="button">Email</a>
      <a href="https://www.linkedin.com" class="button secondary">LinkedIn</a>
      <a href="https://github.com" class="button secondary">GitHub</a>
    </div>
  </section>
</BaseLayout>
